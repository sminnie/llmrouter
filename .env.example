# Which provider actually runs the model calls: ollama | openai | anthropic
PROVIDER=ollama

# Server port
PORT=3000

# Ollama (default, local, free) - no key needed
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI backup (only needed if PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic backup (only needed if PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Where the append-only metrics log lives
METRICS_FILE=data/metrics.jsonl
